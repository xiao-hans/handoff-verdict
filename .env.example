# AgentWebhook configuration sample, environment form.
#
# The equivalent of config.example.toml: the same 19 keys, one per line. Source
# this from your cron wrapper or service manager instead of writing the TOML
# file. An environment value always beats the same key in the config file, and a
# key missing from both makes the program stop with a non-zero exit naming it.
#
# The nineteen above are the whole surface. AGENT_HANDOFF_CONFIG is not listed
# because it is the pointer to the TOML file itself, not a setting with a value
# of its own.
#
# Old PI_HANDOFF_* names are not read at all. If one is set while its
# AGENT_HANDOFF_* twin is unset, every command refuses to run.

# --- required: the recorder and the sender -------------------------------

# State directory for the file queue (events, receipts, outbox, claims).
# Missing: handoff.py exits non-zero and names this key.
export AGENT_HANDOFF_ROOT="<data-root>"

# Main completion-callback receiver URL; loopback only by contract.
# Missing: tick reports "send skipped" and the events stay pending.
export AGENT_HANDOFF_URL="http://127.0.0.1:8644/webhooks/agent-task-handoff"

# Verify-channel receiver URL. Empty: the verify channel stays off.
export AGENT_HANDOFF_VERIFY_URL="http://127.0.0.1:8644/webhooks/agent-task-handoff-verify"

# HMAC signing key file. Missing: the sender refuses any default credential.
export AGENT_HANDOFF_SECRET_FILE="<secret-file>"

# --- optional: protocol numbers (defaults are part of the contract) ------

# Delivery attempts before an event is blocked. Default 60.
export AGENT_HANDOFF_MAX_ATTEMPTS="60"

# Session records read per task per tick. Default 0 means unlimited.
export AGENT_HANDOFF_MAX_RECORDS="0"

# Session bytes read per task per tick. Default 262144.
export AGENT_HANDOFF_MAX_BYTES="262144"

# Silence in seconds before a running task is reported as stalled. Default 3600.
export AGENT_HANDOFF_STALL_SECONDS="3600"

# --- optional: Hermes adapter (only when the adapter is enabled) ---------

# `hermes` executable for telegram delivery. Missing: telegram delivery is
# blocked with a note naming this key; the core commands keep working.
export AGENT_HANDOFF_HERMES_BIN="<hermes-bin>"

# Python interpreter for the local-session mirror. Missing: local delivery is
# blocked with a note naming this key.
export AGENT_HANDOFF_HERMES_PYTHON="<hermes-python>"

# Hermes agent directory the local mirror reads. Missing: local delivery is
# blocked with a note naming this key.
export AGENT_HANDOFF_HERMES_AGENT_DIR="<hermes-agent-dir>"

# Local session id for events with the bare `local` origin. Missing: such an
# event stays unrouted with a reason naming this key.
export AGENT_HANDOFF_LOCAL_SESSION="<local-session-id>"

# --- optional: where the dispatcher finds the recorder -------------------

# State directory the router drives. Missing: the router reports `misconfigured`.
export AGENT_HANDOFF_DATA_ROOT="<data-root>"

# handoff.py the router shells out to. Missing: the router reports
# `misconfigured` instead of guessing a checkout.
export AGENT_HANDOFF_SCRIPT="<path-to>/handoff.py"

# --- optional: the verify lifecycle sweep ---------------------------------
# Spec §1/§6 + the key table in docs/spec/verify-lifecycle-sweep-20261119.md §9.
# Each value below is the built-in default, so omitting the key is legal.

# `sent` verify docs older than this, with no verdict and no live verifier
# lease, go back to `queued` and consume one send attempt.
export AGENT_HANDOFF_VERIFY_SENT_TIMEOUT="900"

# Most stale docs one sweep pass may reclaim.
export AGENT_HANDOFF_VERIFY_SWEEP_MAX="20"

# `nacked` docs older than this are reclaimed, while the nack budget lasts.
export AGENT_HANDOFF_VERIFY_NACK_TIMEOUT="300"

# Nack-driven reclaims a doc may spend before it goes `failed` and raises one
# verify_stalled notice instead of re-arming forever.
export AGENT_HANDOFF_VERIFY_NACK_MAX="3"

# --- optional: who the recorder wakes for a verification notice -----------
# Session the recorder wakes for a verify_blocked / verify_stalled notice
# (Spec §3.4). Empty: the notice still reaches the origin webhook and the status
# line says the wake was skipped, so the router degrades silently.
export AGENT_HANDOFF_ROUTER_TARGET=""
